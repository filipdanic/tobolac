{
  "name": "tobolac",
  "version": "0.1.1",
  "description": "Multi-layer type-safe TypeScript cache library",
  "license": "MIT",
  "repository": "github:filipdanic/tobolac",
  "keywords": [
    "cache",
    "lru",
    "sqlite",
    "typescript",
    "zod",
    "stampede",
    "swr"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:node": "vitest run",
    "test:bun": "bunx vitest run",
    "test:integration:bun": "bunx vitest run --config vitest.integration.config.ts",
    "bench:getorset:bun": "bun run build && bun benchmark/getorset.ts"
  },
  "dependencies": {
    "lru-cache": "^11.2.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "bun-types": "^1.2.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
